                    "group_name": group_name_mapping[group_id]
                })
            return {"data": result, "code": 200}
        return {"data": [], "code": 200}
    except Exception as e:
        logger.error(f"查询组名列表时发生异常: {str(e)}")
        return {"data": None, "code": 500, "error": str(e)}


