            "group2": "测试组2",
            "group3": "测试组3",
            "group4": "测试组4",
            "group5": "测试组5",
            "group6": "测试组6",
            "group7": "测试组7",
            "group8": "苏州智慧公寓",
            "group9": "G1-A04-中国移动信息港"
        }
        liayt = client.getGroupList()
        if liayt and liayt.get("error_code") == 0:
            logger.info(f"查询到的组信息：{liayt}")
            glist = liayt.get("result")
            group_list = glist.get("group_id_list")
