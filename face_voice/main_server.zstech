@app.get('/llm/settings/model-switch-enable')
def get_model_switch_enable():
    """获取切换模型开关(注意把robot_ai_running_path修改为语言robot_ai运行的目录)"""
    if not os.path.exists(config_path):
        return {"code": 500, "message": "Dify配置文件不存在"}
