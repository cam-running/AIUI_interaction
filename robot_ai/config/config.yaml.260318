# 机器人AI语音识别配置文件

# 服务配置
machine-name: "robot_ai"
version: "1.0.0"
machine-id: "d21e4997e4f78314ca991ffa8734c366"
machinename: "小勇"
# 摄像头位置
server:
#  ip: "192.168.123.21"
  ip: "192.168.123.38"
  port: 19199

# 摄像头地址
camera_url: "http://127.0.0.1:34550/camera_base64"
# 语音识别服务选择配置
speech_recognition:
  # 选择使用的语音识别服务: "xunfei_aiui", "baidu_realtime" 或 "xunfei_linux"
  service: "xunfei_linux"

